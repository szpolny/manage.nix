  "query": "SELECT id, organization_id, name, created_at, enrolled_at, agent_version,\n                      facts AS \"facts: Json<Facts>\", facts_updated_at, last_seen_at,\n                      EXISTS (\n                          SELECT 1 FROM agent_sessions AS s\n                          WHERE s.machine_id = machines.id AND s.disconnected_at IS NULL\n                      ) AS \"connected!\"\n               FROM machines WHERE organization_id = $1 ORDER BY name COLLATE \"C\"",
