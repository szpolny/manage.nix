  "db_name": "PostgreSQL",
  "query": "SELECT l.id, l.machine_id, m.name AS \"machine_name?\", l.source, l.text,\n                      l.created_at\n               FROM deployment_logs AS l LEFT JOIN machines AS m ON m.id = l.machine_id\n               WHERE l.deployment_id = $1 AND l.id > $2\n               ORDER BY l.id LIMIT $3",
